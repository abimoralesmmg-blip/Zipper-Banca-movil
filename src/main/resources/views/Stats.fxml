<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.admin.StatsController"
      spacing="12.0" prefWidth="800.0" prefHeight="520.0">

  <!-- ✅ padding corregido -->
  <padding>
    <Insets top="12" right="12" bottom="12" left="12"/>
  </padding>

  <Label text="Estadísticas">
    <font>
      <Font size="18.0"/>
    </font>
  </Label>

  <!-- Resumen rápido -->
  <HBox spacing="20.0">
    <Label text="Total usuarios:"/>
    <Label fx:id="lblTotalUsers" text="0"/>

    <Label text="Total depósitos:"/>
    <Label fx:id="lblTotalDeposits" text="0.00"/>

    <Label text="Usuario con mayor saldo:"/>
    <Label fx:id="lblTopUser" text="---"/>
  </HBox>

  <!-- Tabla de resultados -->
  <TableView fx:id="tvStats" prefHeight="360.0" prefWidth="760.0">
    <columns>
      <TableColumn fx:id="colStatUser" text="Usuario" prefWidth="300.0"/>
      <TableColumn fx:id="colStatMetric" text="Métrica" prefWidth="200.0"/>
      <TableColumn fx:id="colStatValue" text="Valor" prefWidth="200.0"/>
    </columns>
  </TableView>

  <!-- Botones -->
  <HBox spacing="10.0" alignment="CENTER_RIGHT">
    <Button fx:id="btnExportStatsPdf" text="Exportar PDF" onAction="#onExportStatsPdf" prefWidth="140.0"/>
    <Button fx:id="btnExportStatsExcel" text="Exportar Excel" onAction="#onExportStatsExcel" prefWidth="140.0"/>
    <Region/>
    <Button fx:id="btnCloseStats" text="Cerrar" onAction="#onCloseStats" prefWidth="100.0"/>
  </HBox>
</VBox>
