<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="300.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.client.ConfirmacionController">

   <children>
      <!-- Fondo -->
      <ImageView fitHeight="500.0" fitWidth="333.0"
                 pickOnBounds="true" preserveRatio="true"
                 style="-fx-rotate: 180; -fx-scale-x: 1.4; -fx-scale-y: 1; -fx-translate-x: 34;">
         <image>
            <Image url="@../img/fondo.jpg" />
         </image>
      </ImageView>

      <!-- Panel central -->
      <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="45.0" layoutY="175.0"
                 pickOnBounds="true" preserveRatio="true"
                 style="-fx-scale-x: 2; -fx-scale-y: 6;">
         <image>
            <Image url="@../img/rectangulo.png" />
         </image>
      </ImageView>

      <!-- Información de la transferencia -->
      <VBox alignment="CENTER" layoutX="54.0" layoutY="93.0"
            prefHeight="297.0" prefWidth="183.0" spacing="50.0">
         <children>
            <Label fx:id="lblBeneficiario" text="Nombre del Beneficiario: ">
               <font>
                  <Font name="Georgia Bold Italic" size="12.0" />
               </font>
            </Label>
            <Label fx:id="lblCuentaBeneficiario" text="Número de Cuenta:">
               <font>
                  <Font name="Georgia Bold Italic" size="12.0" />
               </font>
            </Label>
            <Label fx:id="lblMontoConfirmacion" text="Monto:">
               <font>
                  <Font name="Georgia Bold Italic" size="12.0" />
               </font>
            </Label>

            <!-- Botones de acción -->
            <HBox alignment="CENTER" spacing="30.0">
               <children>
                  <Button fx:id="btnAceptar" text="Aceptar" onAction="#onAceptar"
                          style="-fx-background-color: #008B8B; -fx-border-color: #FFFFFF; -fx-border-radius: 10;"
                          textFill="#f8f6f6">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Button>

                  <Button fx:id="btnCancelarConfirmacion" text="Cancelar" onAction="#onCancelar"
                          style="-fx-background-color: #008B8B; -fx-border-color: #FFFFFF; -fx-border-radius: 10;"
                          textFill="#fffbfb">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>

      <!-- Botón volver (decorativo o funcional si lo conectas) -->
      <Button layoutX="-44.0" layoutY="365.0"
              mnemonicParsing="false" style="-fx-background-color: #FFFFFF; -fx-scale-x: 0.3; -fx-scale-y: 0.3;">
         <graphic>
            <ImageView fitHeight="163.0" fitWidth="177.0"
                       pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../img/Volver.png" />
               </image>
            </ImageView>
         </graphic>
      </Button>

      <!-- Logo -->
      <ImageView fitHeight="112.0" fitWidth="127.0" layoutX="179.0" layoutY="3.0"
                 pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../img/logo.png" />
         </image>
      </ImageView>
   </children>
</AnchorPane>
