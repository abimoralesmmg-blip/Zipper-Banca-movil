<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="640.0" prefWidth="360.0" style="-fx-background-color: #FFFFFF;"
           xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.client.StartController">
   <children>
      <VBox prefHeight="200.0" prefWidth="320.0" spacing="20.0" StackPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <ImageView fitHeight="231.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" style="-fx-rotate: 270; -fx-translate-x: 109; -fx-translate-y: 144; -fx-scale-x: 4; -fx-scale-y: 4;">
               <image>
                  <Image url="@../img/semicirculo.png" />
               </image>
            </ImageView>
            <ImageView fitHeight="322.0" fitWidth="319.0" pickOnBounds="true" preserveRatio="true" style="-fx-translate-x: 20; -fx-translate-y: -70; -fx-scale-x: 1.1; -fx-scale-y: 1.1;">
               <image>
                  <Image url="@../img/banco.png" />
               </image>
            </ImageView>
            <Button fx:id="btnLogin" mnemonicParsing="false" onAction="#onLogin" onMouseEntered="#handleMouseEnterButton" onMouseExited="#handleMouseExitButton" prefHeight="60.0" prefWidth="240.0" style="-fx-translate-x: 40; -fx-translate-y: -40; -fx-background-color: #5F9EA0; -fx-border-color: #7FFFD4; -fx-font-size: 15; -fx-font-weight: bold;" styleClass="primary-button" text="Iniciar sesión" />
            <Button fx:id="btnRegiste" mnemonicParsing="false" onAction="#onRegister" onMouseEntered="#handleMouseEnterButton" onMouseExited="#handleMouseExitButton" prefHeight="48.0" prefWidth="240.0" style="-fx-translate-x: 40; -fx-translate-y: -30;" styleClass="secondary-button" text="Registrar" />
         </children>
      </VBox>
      <ImageView fitHeight="204.0" fitWidth="167.0" pickOnBounds="true" preserveRatio="true" style="-fx-translate-x: -102; -fx-translate-y: -265;">
         <image>
            <Image url="@../img/logo.png" />
         </image>
      </ImageView>
      <ImageView fitHeight="263.0" fitWidth="287.0" pickOnBounds="true" preserveRatio="true" style="-fx-translate-y: -260; -fx-translate-x: -35;">
         <image>
            <Image url="@../img/Zipper.png" />
         </image>
      </ImageView>
   </children>
</StackPane>
