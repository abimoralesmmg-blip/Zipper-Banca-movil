<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.admin.CreateUserController"
            prefWidth="400" prefHeight="350">

    <children>
        <VBox spacing="10" alignment="CENTER"
              layoutX="40" layoutY="20" prefWidth="320">
            <children>
                <Label text="Crear Usuario" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="30"/>
                        <ColumnConstraints percentWidth="70"/>
                    </columnConstraints>
                    <children>
                        <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Apellido:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtApellido" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Cédula:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtCedula" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label text="Correo:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtCorreo" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        <Label text="Contraseña:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <PasswordField fx:id="txtContrasena" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    </children>
                </GridPane>
                <HBox spacing="10">
                    <children>
                        <Button fx:id="btnCreate" text="Crear" onAction="#onCreate"/>
                        <Button fx:id="btnCancel" text="Cancelar" onAction="#onCancel"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
