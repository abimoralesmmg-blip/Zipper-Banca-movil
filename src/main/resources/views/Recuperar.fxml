            <Image url="@../img/semicirculo.png" />
         </image>
      </ImageView>
      <ImageView fitHeight="576.0" fitWidth="599.0" layoutX="-99.0" layoutY="-197.0" opacity="0.58" pickOnBounds="true" preserveRatio="true" style="-fx-rotate: 180;">
         <image>
            <Image url="@../img/semicirculo.png" />
         </image>
      </ImageView>
      <ImageView fitHeight="283.0" fitWidth="307.0" layoutX="115.0" layoutY="-107.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../img/Zipper.png" />
